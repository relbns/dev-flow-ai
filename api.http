####################################################################################################
# Variables - SET THESE!
####################################################################################################

# Supabase Cloud Instance (Remote)
@supabase_project_ref = xfoxoiurhhqjjhqhoaaf
@supabase_url = https://{{supabase_project_ref}}.supabase.co/functions/v1
@supabase_anon_key = SUPABASE_ANON_KEY

# User JWT - Get this after logging into your DevFlow AI web app
@user_jwt = PASTE_YOUR_FRESH_USER_JWT_HERE

# DevFlow API Key (Generated from Web UI Settings -> Integrations)
# This key is used by AI agents to call the MCP Gateway
@devflow_api_key = dfai_sk_94aac2cbc783cc59967b97d6242e38625d77f25512c296a98778c4e3748384db

# Local Agent Configuration (Ensure these match how your local agent is running)
@local_agent_port = 52173
@local_agent_host = localhost
@local_agent_base_url = http://{{local_agent_host}}:{{local_agent_port}}
# This is the API key you configured your local agent with (via `devflow-local-agent configure` or --api-key flag)
@local_agent_api_key = dfai_sk_7cea784f06f6a91ef35b5c3c2eb80e1be54776d7d0033a73ca5eaf8cdc303f6f


# Test Resource IDs (Update these with actual IDs from your database as needed)
@test_project_id = 6de69e1c-7151-4743-b83b-cf2adbd1c931
@test_task_id = a671a50d-e1af-485a-ad01-b8cba783d1e7
@test_user_id_to_add_as_member = PASTE_USER_ID_OF_ANOTHER_USER_HERE
@test_github_username_to_add_as_member = "testgithubuser"


####################################################################################################
# DevFlow AI - Supabase Cloud MCP Gateway
# (For AI Agents interacting with Supabase-hosted data)
####################################################################################################

### MCP Gateway: Get Project Details
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "get-project-details",
#   "arguments": { "project_id": "{{test_project_id}}" }
# }

### MCP Gateway: List Projects
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "list-projects",
#   "arguments": {}
# }

### MCP Gateway: Create Project
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "create-project",
#   "arguments": {
#     "projectName": "Project Via Gateway",
#     "description": "Test project created by AI agent.",
#     "githubRepoURL": "https://github.com/test/gateway-project"
#   }
# }

### MCP Gateway: Get Task Details
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "get-task-details",
#   "arguments": { "task_id": "{{test_task_id}}" }
# }

### MCP Gateway: List Tasks for a Project
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "list-tasks",
#   "arguments": { "project_id": "{{test_project_id}}" }
# }

### MCP Gateway: Create Task
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "create-task",
#   "arguments": {
#     "project_id": "{{test_project_id}}",
#     "title": "Gateway Created Task",
#     "description": "This task was made by an AI agent."
#   }
# }

### MCP Gateway: Update Task Status
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "update-task-status",
#   "arguments": {
#     "task_id": "{{test_task_id}}",
#     "new_status": "In Progress"
#   }
# }

### MCP Gateway: Add Comment to Task
# POST {{supabase_url}}/mcp-gateway
# Content-Type: application/json
# X-DevFlow-API-Key: {{devflow_api_key}}
#
# {
#   "tool_name": "add-comment-to-task",
#   "arguments": {
#     "task_id": "{{test_task_id}}",
#     "comment_text": "Comment from AI via Gateway.",
#     "author_display_name": "AI Assistant"
#   }
# }


####################################################################################################
# DevFlow AI - Direct Supabase Function Calls (Primarily for UI interactions)
####################################################################################################

### Get GitHub User Organizations (Passes client-side provider_token)
# POST {{supabase_url}}/get-github-orgs-via-token
# Authorization: Bearer {{user_jwt}}
# Content-Type: application/json
# apikey: {{supabase_anon_key}}
#
# {
#   "provider_token": "PASTE_GITHUB_PROVIDER_TOKEN_FROM_BROWSER_SESSION_HERE"
# }

### Generate User API Key
# POST {{supabase_url}}/generate-api-key
# Authorization: Bearer {{user_jwt}}
# Content-Type: application/json
# apikey: {{supabase_anon_key}}
#
# {
#   "name": "My Test API Key"
# }

### List User API Keys
# GET {{supabase_url}}/list-api-keys
# Authorization: Bearer {{user_jwt}}
# apikey: {{supabase_anon_key}}

### Delete User API Key
# @api_key_id_to_delete = PASTE_API_KEY_ID_TO_DELETE_HERE
# POST {{supabase_url}}/delete-api-key
# Authorization: Bearer {{user_jwt}}
# Content-Type: application/json
# apikey: {{supabase_anon_key}}
#
# {
#   "api_key_id": "{{api_key_id_to_delete}}"
# }

### Add Project Member
# POST {{supabase_url}}/add-project-member
# Authorization: Bearer {{user_jwt}}
# Content-Type: application/json
# apikey: {{supabase_anon_key}}
#
# {
#   "project_id": "{{test_project_id}}",
#   "role": "Developer",
#   "github_username": "{{test_github_username_to_add_as_member}}"
# }


####################################################################################################
# DevFlow AI - Local Agent MCP Server
# (For AI Agents interacting with local filesystem/Git)
# Ensure your local agent is running: `devflow-local-agent start-server --api-key YOUR_KEY --root YOUR_PROJECT_ROOT`
# or `devflow-local-agent` if configured.
####################################################################################################

### Local Agent: Get Status (Unprotected)
GET {{local_agent_base_url}}/status

### Local Agent: Get Local File Content (Success)
# Path relative to the agent's --root directory
POST {{local_agent_base_url}}/mcp/get_local_file_content
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "filePath": "package.json" 
}

### Local Agent: Get Local File Content (Auth Failure - wrong key)
POST {{local_agent_base_url}}/mcp/get_local_file_content
Content-Type: application/json
X-DevFlow-API-Key: WRONG_API_KEY

{
  "filePath": "package.json"
}

### Local Agent: Get Local File Content (File Not Found)
POST {{local_agent_base_url}}/mcp/get_local_file_content
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "filePath": "thisfiledoesnotexist.txt"
}

### Local Agent: Get Local File Content (Access Denied - path traversal attempt)
# Example, adjust based on your --root
POST {{local_agent_base_url}}/mcp/get_local_file_content
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "filePath": "../../../../../../../../../../../../etc/hosts" 
}

### Local Agent: Write Local File Content
# Will be created/overwritten in agent's --root
POST {{local_agent_base_url}}/mcp/write_local_file_content
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "filePath": "test-from-agent.txt", 
  "content": "Hello from DevFlow AI Local Agent! Timestamp: {{$$datetime iso8601}}"
}

### Local Agent: List Local Files (Non-recursive)
# List root of the agent's --root directory
POST {{local_agent_base_url}}/mcp/list_local_files
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "directoryPath": ".", 
  "recursive": false
}

### Local Agent: List Local Files (Recursive, specific subdir)
# Path relative to agent's --root
POST {{local_agent_base_url}}/mcp/list_local_files
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "directoryPath": "apps", 
  "recursive": true
}

### Local Agent: Execute Git Command (status)
POST {{local_agent_base_url}}/mcp/execute_git_command
Content-Type: application/json
X-DevFlow-API-Key: {{local_agent_api_key}}

{
  "command_args": ["status"]
}

### Local Agent: Execute Git Command (current branch)
# POST {{local_agent_base_url}}/mcp/execute_git_command
# Content-Type: application/json
# X-DevFlow-API-Key: {{local_agent_api_key}}
#
# {
#   "command_args": ["rev-parse", "--abbrev-ref", "HEAD"]
# }

### Local Agent: Execute Git Command (Disallowed command example)
# POST {{local_agent_base_url}}/mcp/execute_git_command
# Content-Type: application/json
# X-DevFlow-API-Key: {{local_agent_api_key}}
#
# {
#   "command_args": ["config", "--global", "user.name"] # This should be disallowed
# }
