# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/devflow-ai

# JWT - Replace this with a strong random secret in production
JWT_SECRET=devflow-ai-jwt-secret-for-development

# GitHub OAuth
# Replace these with your new GitHub OAuth app credentials
GITHUB_CLIENT_ID=your_new_client_id_here
GITHUB_CLIENT_SECRET=your_new_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000