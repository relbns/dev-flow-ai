{
  "version": 2,
  "builds": [
    {
      "src": "src/api.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10,
        "memory": 1024
      }
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 1,
        "memory": 128
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/src/api.js"
    },
    {
      "src": "/auth/github/login",
      "dest": "/src/api.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}