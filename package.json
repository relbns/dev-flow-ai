{
  "name": "dev-flow-ai",
  "version": "1.0.0",
  "description": "Developer workflow automation tools",
  "main": "index.js",
  "scripts": {
    "start:server": "cd apps/server && npm start",
    "start:web": "cd apps/web && npm run dev",
    "dev": "concurrently \"npm run start:server\" \"npm run start:web\"",
    "setup:server": "cd apps/server && npm run setup",
    "setup": "npm install && npm run setup:server"
  },
  "keywords": [
    "development",
    "workflow",
    "automation",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}