{
  "name": "dev-flow-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for DevFlow AI application, web frontend, local agent, and Supabase functions.",
  "scripts": {
    "dev": "npm run dev --workspace=@dev-flow-ai/web",
    "build": "npm run build --workspace=@dev-flow-ai/web",
    "lint": "npm run lint --workspace=@dev-flow-ai/web",
    "local-agent": "node packages/local-agent-cli/index.js get-file-content packages/local-agent-cli/package.json",
    "local-agent:hello": "node packages/local-agent-cli/index.js hello",
    "local-agent:help": "node packages/local-agent-cli/index.js --help",
    "local-agent:git:status": "node packages/local-agent-cli/index.js git status",
    "local-agent:git:branch": "node packages/local-agent-cli/index.js git -- rev-parse --abbrev-ref HEAD",
    "local-agent:git:checkout-b": "node packages/local-agent-cli/index.js git -- checkout -b test-branch-cli",
    "local-agent:git:checkout-main": "node packages/local-agent-cli/index.js git -- checkout master",
    "local-agent:git:add": "node packages/local-agent-cli/index.js git -- add .",
    "local-agent:git:commit": "node packages/local-agent-cli/index.js git -- commit -m \"Test commit from CLI\"",
    "local-agent:git:push": "node packages/local-agent-cli/index.js git push",
    "supabase:start": "echo \"Ensure Supabase CLI is installed. Run: supabase start\"",
    "supabase:deploy": "echo \"Ensure Supabase CLI is installed. Run: supabase functions deploy --project-ref <YOUR-PROJECT-REF>\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "ai",
    "developer-tools",
    "kanban",
    "github",
    "mcp",
    "supabase",
    "react"
  ],
  "author": "",
  "license": "ISC"
}
